{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "inventory-management",
  "version": "0.1.3",
  "identifier": "com.m5c.inventory",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3005",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "M5C Logistics - Inventory Management",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwNTdBQTlBOThEQkVBRTgKUldUbzZ0dVltcXBYZ092M1ZlWDFPQnl6TEpUTERwaXI5Um1TblBrVUl2SnpuSHlxcWdWUjVnWk8K",
      "endpoints": [
        "https://raw.githubusercontent.com/M5Csoftware/inventory-management/main/version.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
